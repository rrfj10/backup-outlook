# Copie este arquivo para:
# ~/Library/Application Support/BackupOutlook/.env
#
# Variáveis de ambiente definidas no shell têm prioridade sobre este arquivo.

# Use "auto" para detectar o perfil real do Outlook no macOS.
# Se preferir, substitua por um caminho absoluto para um perfil especifico.
ORIGEM="auto"
DESTINO="$HOME/Library/CloudStorage/OneDrive/Outlook-Backups"

# Agendamento do backup automático (lido por install_automation.sh).
# Depois de alterar qualquer valor abaixo, rode ./install_automation.sh de novo
# para aplicar. Backups avulsos continuam via "backup_outlook_professional.py backup",
# a qualquer momento, independente deste agendamento.
#
# BACKUP_FREQUENCY: daily | weekly | monthly (padrão: monthly)
#   daily   -> roda todo dia, usa apenas BACKUP_HOUR/BACKUP_MINUTE
#   weekly  -> roda 1x por semana, usa BACKUP_WEEKDAY + HOUR/MINUTE
#   monthly -> roda 1x por mês, usa BACKUP_DAY + HOUR/MINUTE
BACKUP_FREQUENCY=monthly

# Horário (24h), vale para qualquer frequência.
BACKUP_HOUR=2
BACKUP_MINUTE=0

# Só usado quando BACKUP_FREQUENCY=monthly. Dia do mês, 1-28
# (28 pra evitar meses sem dia 29/30/31).
BACKUP_DAY=1

# Só usado quando BACKUP_FREQUENCY=weekly. Dia da semana, 0-6
# (0=domingo, 1=segunda, ..., 6=sábado).
BACKUP_WEEKDAY=1
