<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.backupoutlook.scheduled</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__RUNTIME_SCRIPT__</string>
    <string>backup</string>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/backup_outlook_scheduled.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/backup_outlook_scheduled_error.log</string>
</dict>
</plist>
